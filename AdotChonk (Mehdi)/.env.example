# Copy to .env and fill in. Demo Mode works with ONLY the Mistral key set;
# without a key the app falls back to deterministic local analysis (still fully demoable).
MISTRAL_API_KEY=

# Model IDs (check console.mistral.ai for the exact "Mistral Large 4 / Le Chonk" ID at hackathon time;
# fall back to mistral-large-latest if unsure).
MISTRAL_LARGE_MODEL=mistral-large-latest
MISTRAL_SMALL_MODEL=mistral-small-latest
MISTRAL_VOICE_MODEL=voxtral-mini-latest

# Business maths shown on the dashboard
HOURLY_RATE_GBP=15
# Assumed manual minutes per handled rejection email (used for "time saved" estimates)
MINUTES_PER_EMAIL=3.5
# Applications with Status "Applied" older than this many days become "Ghosted"
GHOSTED_DAYS=21
# A recorded session is assumed to represent one workday; weekly = daily * this
WORKDAYS_PER_WEEK=5

# Use a real Mistral Agent (beta.agents) for the automation run when a key is present.
# If anything fails it falls back to the deterministic pipeline.
USE_MISTRAL_AGENT=1

TRACKER_PATH=backend/demo_data/applications.xlsx
DB_PATH=backend/demo_data/autopilot.db
API_BASE=http://localhost:8000
USER_NAME=Alex

{
  "manifest_version": 3,
  "name": "AutoPilot Observer",
  "version": "0.1.0",
  "description": "Records your work actions (never typed text) and sends them to AutoPilot on localhost to detect repetitive tasks.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "AutoPilot Observer" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
